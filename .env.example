# Копирай като ~/.google-ads.env  (chmod 600)
#
# ВАЖНО: всичко тук трябва да е вързано за ЕДИН И СЪЩ Google акаунт -
# и Google Cloud проектът, и съгласието при OAuth, и достъпът до MCC-то.
# Ако смесиш два акаунта, ще получаваш USER_PERMISSION_DENIED без ясна причина.

# --- Developer token ---
# MCC акаунт → Tools & Settings → Setup → API Center.
# Менюто се вижда САМО от manager (MCC) акаунт.
# Basic access стига за 15 000 операции на ден.
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- OAuth клиент ---
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# → тип "Desktop app".
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Попълва се автоматично от `npm run oauth`.
# На consent екрана се логни със същия Google акаунт, който има достъп до MCC-то.
GOOGLE_ADS_REFRESH_TOKEN=

# --- MCC ---
# ID-то на manager акаунта, само цифри (без тирета).
# Това е ключът към „неограничени акаунти": всичко под този MCC става достъпно.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- По желание ---
# Версия на Google Ads API. v24 е по подразбиране.
# GOOGLE_ADS_API_VERSION=v25

# Предварително избран акаунт на consent екрана при `npm run oauth`.
# GOOGLE_ADS_OAUTH_LOGIN_HINT=your-account@example.com
